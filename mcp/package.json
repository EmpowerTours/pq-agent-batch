{
  "name": "@empowertours/pqagent-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "MCP server for the pq-agent-batch proof-of-agency registry: check, verify and register post-quantum AI agents from any MCP client (stdio + streamable HTTP)",
  "license": "MIT",
  "type": "module",
  "bin": {
    "pqagent-mcp": "dist/cli.js"
  },
