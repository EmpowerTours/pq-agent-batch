    "start": "node dist/cli.js",
    "test": "vitest run",
    "smoke": "node --import tsx scripts/smoke.ts"
  },
  "dependencies": {
    "@empowertours/pqagent": "0.1.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "viem": "^2.57.7",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
